<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- SCREEN 1: Selection -->
    <LinearLayout
        android:id="@+id/screen_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите метод калибровки"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="40dp" />
        <Button
            android:id="@+id/btn_sun_calib"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="Калибровка по Солнцу"
            android:layout_marginBottom="20dp"/>
        <Button
            android:id="@+id/btn_gps_calib"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="Калибровка по GPS"/>
    </LinearLayout>

    <!-- SCREEN 2: Sun Calibration -->
    <RelativeLayout
        android:id="@+id/screen_sun"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <android.hardware.Camera xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        
        <!-- Grey Target Circle -->
        <View
            android:id="@+id/target_circle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            android:background="@android:color/darker_gray" />
        
        <!-- White Sun Circle (Simulated or Tracker) -->
        <View
            android:id="@+id/sun_circle"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="#FFFFFF"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/tv_sun_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/target_circle"
            android:layout_centerHorizontal="true"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:text="↑" />
    </RelativeLayout>

    <!-- SCREEN 3: GPS Calibration -->
    <LinearLayout
        android:id="@+id/screen_gps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Инструкция по GPS калибровке:"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Закрепите телефон на селфи-палке. Вытяните руку и сделайте плавный разворот корпуса более чем на 90 градусов для записи траектории."
            android:textColor="#BBBBBB"
            android:gravity="center"
            android:layout_marginBottom="30dp" />
        <Button
            android:id="@+id/btn_start_gps_track"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Я готов (Старт)"/>
    </LinearLayout>

    <!-- SCREEN 4: Aiming Screen -->
    <LinearLayout
        android:id="@+id/screen_aiming"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_current_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: поиск..."
            android:textColor="#FFFFFF"/>
        <TextView
            android:id="@+id/tv_current_angles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Азимут: 0.0° | Угол места: 0.0°"
            android:textColor="#FFFF00"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/et_target_azimuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Целевой азимут (0-360)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="numberDecimal"
            android:layout_marginTop="20dp"/>
        <EditText
            android:id="@+id/et_target_elevation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Целевой угол места (0-90)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="numberDecimal"/>

        <!-- Vector Animation Canvas / Placeholder -->
        <View
            android:id="@+id/vector_view"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:background="#222222" />
    </LinearLayout>
</FrameLayout>
